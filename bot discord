@bot.command()
async def hello(ctx):
    await ctx.send("Hi!")

@bot.command()
async def bye(ctx):
    await ctx.send("👍te esperamos de vuelta")

@bot.command()
async def password(ctx, caracteres: int):
    await ctx.send(f"Su contrasenna es: {gen_pass(caracteres)}")

@bot.group()
async def cool(ctx):
    """says if a user is cool.
    
    In reality this just checks if a subcommand is being invoked.
    """
    if ctx.invoked_subcommand is None:
        await ctx.send('No, {0.subcommand_passed} is not cool'.format(ctx))

@cool.command(name='bot')
async def _bot(ctx):
    """Is the bot cool?"""
    await ctx.send('Yes, the bot is cool.')
